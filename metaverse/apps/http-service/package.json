{
  "name": "http",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "vitest run",
    "build": "npx esbuild src/index.ts --format=esm --bundle --packages=external --outfile=dist/index.js --platform=node --tsconfig=tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "predev": "npx --yes kill-port 3000",
    "dev:build": "tsc -w",
    "dev:start": "tsx watch --env-file=.env src/index.ts",
    "dev": "concurrently --kill-others \"npm run dev:build\" \"npm run dev:start\"",
    "postdev": "npx --yes kill-port 3000"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@repo/db": "*",
    "@repo/types": "*",
    "cors": "^2.8.6",
    "dotenv": "^16.0.3",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.3",
    "typescript": "^5.9.2",
    "zod": "^4.4.3"
  }
}
