{
  "name": "ws-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "npx esbuild src/index.ts --format=esm --bundle --packages=external --outfile=dist/index.js --platform=node --tsconfig=tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "dev:build": "tsc -b -w",
    "dev:start": "nodemon --watch src --exec \"tsx --env-file=.env\" src/index.ts",
    "dev": "concurrently \"npm run dev:build\" \"npm run dev:start\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@repo/db": "*",
    "@repo/types": "*",
    "@types/ws": "^8.18.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
